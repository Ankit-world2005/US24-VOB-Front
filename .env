# Backend server URL (defaults to localhost:8000; replace with other PC's IP e.g. http://192.168.1.50:8000 if not port-forwarded)
# Remote PC target (192.168.1.2) refused connections on :8000 - backend is running locally.
# VITE_BACKEND_URL=http://192.168.1.2:8000/
VITE_BACKEND_URL=http://10.59.197.68:8000/# BACKEND_URL=http://192.168.1.2:8000
BACKEND_URL=http://10.59.197.68:8000/
# Relative base path for API calls (empty string routes through the Vite proxy)
VITE_API_BASE_URL=

# Set to false to disable local mock and send all requests to the backend
VITE_USE_MOCK=false

# Optional fallback to mock data if backend connection fails (set to true if you want local fallback when backend is offline)
# Backend currently implements /api/v1/auth only; every other route 404s.
# With this on, those routes serve mock data while the backend catches up.
# Auth is never faked - see the guard in src/api/client.js.
VITE_FALLBACK_MOCK=true
