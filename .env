# Backend server URL (defaults to localhost:8000)
VITE_BACKEND_URL=http://localhost:8000
BACKEND_URL=http://localhost:8000

# Relative base path for API calls (empty string routes through Vite proxy in dev)
VITE_API_BASE_URL=

# No mock data - all requests route directly to live backend
VITE_USE_MOCK=false
VITE_FALLBACK_MOCK=false
