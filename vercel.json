{
  "framework": "vite",
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://us-24-vob.vercel.app/api/:path*"
    },
    {
      "source": "/healthz",
      "destination": "https://us-24-vob.vercel.app/healthz"
    },
    {
      "source": "/readyz",
      "destination": "https://us-24-vob.vercel.app/readyz"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
